---
/* 1200x630 card, screenshotted to /og.png by scripts/render-artifacts.mjs. Not linked from anywhere.
   Standalone page, always light: colors mirror the light tokens in src/styles/global.css. */
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif";
import { Image } from "astro:assets";
import photo from "../assets/thomas.jpeg";
import { person, site, summaryParts, yearsOfExperience } from "../data/resume";

const host = site.url.replace(/^https?:\/\//, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{person.name}, Open Graph card</title>
  </head>
  <body>
    <div class="card">
      <div class="top">
        <Image src={photo} alt="" width={120} height={120} densities={[1, 2]} class="photo" />
        <div>
          <h1 class="name">{person.name}</h1>
          <p class="role">{person.engagement} · {person.role}</p>
        </div>
      </div>
      <p class="tagline">{summaryParts(yearsOfExperience)[0]}</p>
      <p class="host">{host}</p>
    </div>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #faf9f6;
    color: #151515;
    font-family: "Inter Variable", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .card {
    height: 100%;
    padding: 76px 80px 72px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
  }

  .name {
    margin: 0;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 112px;
    line-height: 0.95;
    letter-spacing: -0.015em;
  }

  .role {
    margin: 14px 0 0;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
    color: #454545;
  }

  .tagline {
    margin: 0;
    font-size: 38px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    max-width: 28ch;
    color: #454545;
  }

  .host {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    color: #a63a12;
  }
</style>
