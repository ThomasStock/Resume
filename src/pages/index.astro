---
import Layout from "../layouts/Layout.astro";
import Actions from "../components/Actions.astro";
import Header from "../components/Header.astro";
import Now from "../components/Now.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Footer from "../components/Footer.astro";
import { person, summaryParts, yearsOfExperience } from "../data/resume";
---

<Layout title={`${person.name}, ${person.role}`} description={summaryParts(yearsOfExperience)[0]}>
  <main class="page">
    <Actions />
    <Header />
    <Now />
    <Experience />
    <Skills />
    <Footer />
  </main>
</Layout>
