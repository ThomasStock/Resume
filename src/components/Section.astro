---
interface Props {
  id: string;
  title: string;
  accent?: boolean;
}

const { id, title, accent = false } = Astro.props;
---

<section class="section" aria-labelledby={`${id}-heading`}>
  <div class="side">
    <h2 id={`${id}-heading`} class:list={["label", { accent }]}>{title}</h2>
    <slot name="side" />
  </div>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem 2rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--rule);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.15rem;
  }

  @media (max-width: 640px) {
    .section {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.75rem 0;
    }

    .side {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  @media print {
    .section {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.4rem 1.25rem;
      padding: 0.75rem 0;
    }
  }
</style>
