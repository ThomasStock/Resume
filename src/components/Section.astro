---
interface Props {
  id: string;
  title: string;
  accent?: boolean;
}

const { id, title, accent = false } = Astro.props;
---

<section class="section" aria-labelledby={`${id}-heading`}>
  <div class="side">
    <h2 id={`${id}-heading`} class:list={["title", { accent }]}>{title}</h2>
    <slot name="side" />
  </div>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--rule);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  /* Section titles share the name's serif, so the pairing is structural rather than a one-word flourish. */
  .title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--fg);
  }

  .title.accent {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .section {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 2rem 0;
    }

    .side {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  @media print {
    .section {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 0.3rem 1rem;
      padding: 0.7rem 0;
    }

    .title {
      font-size: 1.25rem;
    }
  }
</style>
