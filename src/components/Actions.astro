---
/* Format switcher. Only client-side script on the site: copy /resume.md to the clipboard. */
---

<nav class="actions screen-only" aria-label="Other formats">
  <a href="/ThomasStock.pdf" download>PDF</a>
  <button type="button" data-copy-markdown>Copy as Markdown</button>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-markdown]");
  button?.addEventListener("click", async () => {
    const label = button.textContent;
    try {
      const markdown = await fetch("/resume.md").then((r) => r.text());
      await navigator.clipboard.writeText(markdown);
      button.textContent = "Copied";
    } catch {
      window.location.href = "/resume.md";
      return;
    }
    setTimeout(() => (button.textContent = label), 1600);
  });
</script>

<style>
  .actions {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 10;
    display: flex;
    gap: 0.4rem;
  }

  .actions a,
  .actions button {
    font: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    color: var(--fg-2);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .actions a:hover,
  .actions button:hover {
    border-color: var(--accent);
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .actions {
      position: static;
      padding: 1rem 1.5rem 0;
      flex-wrap: wrap;
    }
  }
</style>
