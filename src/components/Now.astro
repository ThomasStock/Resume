---
import Section from "./Section.astro";
import { now } from "../data/resume";
import { formatMonthShort } from "../lib/format";
import { inlineHtml } from "../lib/inline";
---

<Section id="now" title="Now" accent>
  <time slot="side" datetime={now.updated} class="updated">Updated {formatMonthShort(now.updated)}</time>
  <ul class="now">
    {now.items.map((item) => (
      <li>
        <span set:html={inlineHtml(item)} />
      </li>
    ))}
  </ul>
</Section>

<style>
  .updated {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .now {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  /* Bullet as a grid cell, not a positioned pseudo-element: keeps PDF text in reading order.
     Content sits in one span so inline markup does not become extra grid items. */
  .now li {
    display: grid;
    grid-template-columns: 0.4em minmax(0, 1fr);
    column-gap: 0.75em;
    align-items: start;
  }

  .now li::before {
    content: "";
    width: 0.4em;
    height: 0.4em;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--accent);
  }

  @media print {
    .now {
      gap: 0.2rem;
      font-size: 1rem;
    }
  }
</style>
