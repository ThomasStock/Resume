---
import { Image } from "astro:assets";
import photo from "../assets/thomas.jpeg";
import { locationLabel, person, site, summary, yearsOfExperience } from "../data/resume";

const host = site.url.replace(/^https?:\/\//, "");
---

<header class="header">
  <div class="identity">
    <Image
      src={photo}
      alt={`Portrait of ${person.name}`}
      width={80}
      height={80}
      densities={[1, 2, 3]}
      loading="eager"
      class="photo"
    />
    <div>
      <p class="label">{person.engagement} · {person.role}</p>
      <h1 class="name">{person.name}</h1>
    </div>
  </div>

  <p class="summary">{summary(yearsOfExperience)}</p>

  <address class="meta">
    <span>{locationLabel}</span>
    {person.availability && <span class="availability">{person.availability}</span>}
    <a href={`mailto:${person.email}`}>{person.email}</a>
    {person.profiles.map((p) => <a href={p.url} rel="me noopener">{p.network}</a>)}
    <a href={site.url} class="print-only-inline">{host}</a>
  </address>
</header>

<style>
  .header {
    padding-bottom: 2.25rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .photo {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3rem, 9vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.015em;
    margin-top: 0.3rem;
  }

  .summary {
    color: var(--fg-2);
    font-size: 1.125rem;
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-style: normal;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .availability {
    color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .identity {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
  }

  @media print {
    .header {
      padding-bottom: 0.8rem;
    }

    .identity {
      gap: 1rem;
      margin-bottom: 0.8rem;
    }

    .photo {
      width: 3.4rem;
      height: 3.4rem;
    }

    .name {
      font-size: 2.8rem;
    }

    .summary {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .meta {
      font-size: 0.9rem;
      gap: 0.2rem 0.9rem;
    }
  }
</style>
