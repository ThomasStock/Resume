---
import Section from "./Section.astro";
import { coreSkills, moreSkills } from "../data/resume";
---

<Section id="skills" title="Skills">
  <p class="core">
    {coreSkills.map((s) => <span>{s}</span>)}
  </p>
  <p class="more">
    <span class="more-label">Also worked with</span>
    {moreSkills.join(", ")}
  </p>
</Section>

<style>
  .core {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.65;
    letter-spacing: -0.005em;
  }

  .core span + span::before {
    content: " · ";
    color: var(--muted);
    font-weight: 400;
  }

  .more {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .more-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }

  @media print {
    .core {
      font-size: 1rem;
    }

    .more {
      margin-top: 0.4rem;
      font-size: 0.85rem;
      line-height: 1.45;
    }
  }
</style>
